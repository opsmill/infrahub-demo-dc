{#- ============================================================================
    KVM/libvirt VM Provisioning Script

    Builds a NoCloud seed ISO from Infrahub-rendered user-data and boots a
    clone of a cloud image template (convention: /var/lib/libvirt/images/
    tpl-<os_version slug>.qcow2). Run on the target KVM host as root.
    ============================================================================ -#}
{% set vm = data.VirtualizationVirtualMachine.edges[0].node %}
{% import "templates/configs/partials/vm_macros.j2" as vm_macros %}
{% set is_windows = vm.platform.node and vm.platform.node.name.value == "Windows" %}
{% set tpl = vm_macros.image_name(vm) %}
#!/bin/bash
{{ vm_macros.banner(vm) }}
set -euo pipefail

{% if vm.vcpus.value is none or vm.memory.value is none or vm.disk.value is none or vm.os_version.value is none %}
# This VM has no complete size or OS recorded in Infrahub. vcpus, memory,
# disk and os_version are optional in the schema (a size profile normally
# sets the first three), so a VM written directly through the SDK or API can
# be missing them - refuse to render a script that would fail or
# misprovision at deploy time.
echo "ERROR: {{ vm.name.value }} needs vcpus, memory, disk and os_version set in Infrahub" >&2
exit 1
{% else %}
IMAGES=/var/lib/libvirt/images
if [ ! -f "$IMAGES/{{ tpl }}.qcow2" ]; then
  echo "ERROR: template image $IMAGES/{{ tpl }}.qcow2 not found" >&2
  exit 1
fi

WORKDIR="$(mktemp -d)"
trap 'rm -rf "$WORKDIR"' EXIT

# Cloud-init user-data rendered by Infrahub (see the vm-userdata artifact).
cat > "$WORKDIR/user-data" <<'CLOUDINIT'
{% include "templates/configs/partials/vm_userdata.j2" %}
CLOUDINIT

{# Quoted delimiter: nothing in the rendered metadata may be expanded by the
   shell, or a crafted VM name would execute inside this root-run script. #}
cat > "$WORKDIR/meta-data" <<'METADATA'
instance-id: {{ vm.name.value }}
local-hostname: {{ vm.name.value }}
METADATA

cloud-localds "$IMAGES/{{ vm.name.value }}-seed.iso" "$WORKDIR/user-data" "$WORKDIR/meta-data"

cp "$IMAGES/{{ tpl }}.qcow2" "$IMAGES/{{ vm.name.value }}.qcow2"
qemu-img resize "$IMAGES/{{ vm.name.value }}.qcow2" {{ vm.disk.value }}G

virt-install \
  --name "{{ vm.name.value }}" \
  --vcpus {{ vm.vcpus.value }} \
  --memory {{ (vm.memory.value * 1024) | int }} \
  --disk "$IMAGES/{{ vm.name.value }}.qcow2,bus=virtio" \
  --disk "$IMAGES/{{ vm.name.value }}-seed.iso,device=cdrom" \
  --network bridge=br0,model=virtio \
  --os-variant {{ "win2k22" if is_windows else "ubuntu22.04" }} \
  --import \
  --noautoconsole

{% if vm.status.value != "active" %}
# Status is "{{ vm.status.value }}" - shut the VM down after first-boot import.
virsh shutdown "{{ vm.name.value }}" || true
{% endif %}
{% endif %}
