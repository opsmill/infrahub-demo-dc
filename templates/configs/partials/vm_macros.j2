{#- ============================================================================
    Shared pieces of the per-hypervisor VM provisioning templates.

    Every provisioning template opens the same way: a banner naming the VM and
    where it runs, and the name of the template image it clones. Both derive
    from the cluster's VirtualizationHypervisorType, so they live here rather
    than in four copies that have to be edited together.

    Imported, not included - `{% include %}` does not export macros:

        {% import "templates/configs/partials/vm_macros.j2" as vm_macros %}
    ============================================================================ -#}

{#- Family key (proxmox, kvm, ...) for display. -#}
{%- macro hypervisor_name(vm) -%}
{%- set hyp = (vm.cluster.node.get("hypervisor_type") or {}).get("node") -%}
{{ hyp.name.value if hyp and hyp.name.value else "unknown" }}
{%- endmacro -%}

{#- Name of the template image the VM is cloned from. The prefix is a property
    of the hypervisor family; "tpl-" is the fallback for a cluster whose family
    has no row yet. -#}
{%- macro image_name(vm) -%}
{%- set hyp = (vm.cluster.node.get("hypervisor_type") or {}).get("node") -%}
{{ (hyp.image_prefix.value if hyp and hyp.image_prefix.value else "tpl-") ~ (vm.os_version.value | lower | replace(" ", "-")) }}
{%- endmacro -%}

{#- The comment header every provisioning script opens with, below its shebang. -#}
{%- macro banner(vm) -%}
# Auto-generated by Infrahub - do not edit by hand.
# VM: {{ vm.name.value }}
# Host: {{ vm.host.node.name.value }}
# Cluster: {{ vm.cluster.node.name.value }} ({{ hypervisor_name(vm) }})
{%- endmacro -%}
