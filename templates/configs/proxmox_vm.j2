{#- ============================================================================
    Proxmox VE VM Provisioning Script

    Clones a cloud-init-ready template (convention: tpl-<os_version slug>,
    e.g. tpl-ubuntu-22.04) and configures it via the cloud-init drive:
    user-data comes from the Infrahub-rendered snippet (--cicustom), the IP
    from --ipconfig0. Run on the target Proxmox node as root/PVEVMAdmin.

    Rendered with trim_blocks/lstrip_blocks enabled (infrahub_sdk defaults).
    ============================================================================ -#}
{% set vm = data.VirtualizationVirtualMachine.edges[0].node %}
{% set is_windows = vm.platform.node and vm.platform.node.name.value == "Windows" %}
{% set hyp = (vm.cluster.node.get("hypervisor_type") or {}).get("node") %}
{# Image prefix is a property of the hypervisor family, held on
   VirtualizationHypervisorType; "tpl-" is the fallback for a cluster whose
   type has no row yet. #}
{% set tpl = (hyp.image_prefix.value if hyp and hyp.image_prefix.value else "tpl-") ~ (vm.os_version.value | lower | replace(" ", "-")) %}
#!/bin/bash
# Auto-generated by Infrahub - do not edit by hand.
# VM: {{ vm.name.value }}
# Host: {{ vm.host.node.name.value }}
# Cluster: {{ vm.cluster.node.name.value }} ({{ vm.cluster.node.cluster_type.value }})
set -euo pipefail

{% if vm.vmid.value is none %}
# This VM has no VMID assigned in Infrahub. A VMID is required to provision
# on Proxmox - set one on the VirtualizationVirtualMachine object and
# regenerate this artifact.
echo "ERROR: {{ vm.name.value }} has no VMID assigned in Infrahub" >&2
exit 1
{% else %}
TEMPLATE_VMID="$(qm list | awk -v t="{{ tpl }}" '$2 == t {print $1}')"
if [ -z "$TEMPLATE_VMID" ]; then
  echo "ERROR: template {{ tpl }} not found on this node" >&2
  exit 1
fi

# Cloud-init user-data rendered by Infrahub (see the vm-userdata artifact).
cat > "/var/lib/vz/snippets/{{ vm.name.value }}-user-data.yml" <<'CLOUDINIT'
{% include "templates/configs/partials/vm_userdata.j2" %}
CLOUDINIT

qm clone "$TEMPLATE_VMID" {{ vm.vmid.value }} --name "{{ vm.name.value }}" --full

qm set {{ vm.vmid.value }} \
  --cores {{ vm.vcpus.value }} \
  --memory {{ (vm.memory.value * 1024) | int }} \
  --net0 virtio,bridge=vmbr0 \
  --ide2 local-lvm:cloudinit \
  --cicustom "user=local:snippets/{{ vm.name.value }}-user-data.yml" \
{% if vm.primary_address.node %}
  --ipconfig0 "ip={{ vm.primary_address.node.address.value }}" \
{% endif %}
  --ostype {{ "win11" if is_windows else "l26" }} \
  --agent enabled=1

qm disk resize {{ vm.vmid.value }} scsi0 {{ vm.disk.value }}G

qm set {{ vm.vmid.value }} --description "{{ vm.description.value or vm.name.value }}{% if vm.os_version.value %} - {{ vm.os_version.value }}{% endif %}"

{% if vm.tags.edges %}
qm set {{ vm.vmid.value }} --tags "{{ vm.tags.edges | map(attribute="node.name.value") | join(",") }}"

{% endif %}
{% if vm.status.value == "active" %}
qm start {{ vm.vmid.value }}
{% else %}
# Status is "{{ vm.status.value }}" - VM created but left powered off.
{% endif %}
{% endif %}
